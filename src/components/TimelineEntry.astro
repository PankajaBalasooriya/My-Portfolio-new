---
import LogoChip from './LogoChip.astro';

interface Props {
  org: string;
  role: string;
  location?: string;
  /** Pre-formatted, e.g. "December 2024 — July 2025". */
  period: string;
  /** Pre-formatted, e.g. "8 mos". */
  duration?: string;
  /** Percentages of the parent Timeline's shared scale. */
  span?: { left: number; width: number };
  details?: string[];
  logo?: string;
  logoDark?: string;
  headingLevel?: 3 | 4;
}

const {
  org,
  role,
  location,
  period,
  duration,
  span,
  details = [],
  logo,
  logoDark,
  headingLevel = 3,
} = Astro.props as Props;

const Heading = `h${headingLevel}` as keyof astroHTML.JSX.DefinedIntrinsicElements;
---

<li class="relative flex gap-4 pb-9 last:pb-0 sm:gap-5">
  {/* Sits above the rail; the chip's own background masks the line behind it. */}
  <div class="relative z-10">
    <LogoChip logo={logo} logoDark={logoDark} name={org} />
  </div>

  <div class="min-w-0 flex-1">
    <div class="sm:flex sm:items-start sm:justify-between sm:gap-6">
      <div class="min-w-0 sm:pt-0.5">
        <Heading class="font-display text-lg leading-snug">{org}</Heading>
        <p class="mt-1 text-accent">{role}</p>
        {location && <p class="mt-0.5 text-sm text-faint">{location}</p>}
      </div>

      <div class="mt-2 shrink-0 sm:mt-0 sm:w-40 sm:text-right">
        <p class="text-sm tabular-nums text-faint">{period}</p>
        {duration && <p class="mt-0.5 text-xs text-faint">{duration}</p>}

        {
          /* The bar repeats what the dates already say, so it is hidden from
             assistive tech rather than announced as a second, vaguer copy. */
          span && (
            <div class="mt-2 h-[3px] w-full rounded-full bg-border" aria-hidden="true">
              <div
                class="h-full rounded-full bg-muted"
                style={`margin-left:${span.left.toFixed(2)}%;width:${span.width.toFixed(2)}%`}
              />
            </div>
          )
        }
      </div>
    </div>

    {
      details.length > 0 && (
        <ul class="mt-3 space-y-1.5 text-muted">
          {details.map((detail) => (
            <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-1 before:w-1 before:rounded-full before:bg-faint">
              {detail}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
