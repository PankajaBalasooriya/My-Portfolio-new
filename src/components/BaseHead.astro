---
import { getImage } from 'astro:assets';
import { site, verifiedProfiles, ORCID } from '../lib/site';
import portraitSrc from '../assets/portrait.png';
import { url, absoluteUrl, absoluteFromPathname } from '../lib/url';
import fraunces from '../assets/fonts/fraunces-latin-opsz.woff2?url';
import inter from '../assets/fonts/inter-latin-wght.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Site-root-relative path to an OG image, e.g. "/og-default.png". */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = absoluteFromPathname(Astro.url.pathname, Astro.site);
const ogImage = absoluteUrl(image, Astro.site);
const fullTitle = title === site.title ? title : `${title} · ${site.title}`;

// A real photograph is a better Person image than the generic OG card.
const portrait = await getImage({ src: portraitSrc, width: 600, format: 'jpeg' });

/**
 * schema.org Person. `sameAs` carries only profiles confirmed to belong to
 * this person — see `verifiedProfiles` in lib/site.ts. The university is listed
 * under `affiliation` rather than `alumniOf`, which would imply graduation.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  url: absoluteUrl('/', Astro.site),
  email: site.author.email,
  description: site.description,
  jobTitle: site.jobTitle,
  image: absoluteFromPathname(portrait.src, Astro.site),
  affiliation: [
    {
      '@type': 'CollegeOrUniversity',
      name: site.organizations.university.name,
      url: site.organizations.university.url,
    },
    {
      '@type': 'Organization',
      name: site.organizations.lab.name,
      url: site.organizations.lab.url,
    },
  ],
  knowsAbout: [...site.knowsAbout],
  // ORCID appears both as an identifier (the scholarly convention) and in
  // sameAs, which is what general-purpose crawlers actually read.
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: `https://orcid.org/${ORCID}`,
  },
  ...(verifiedProfiles.length > 0 ? { sameAs: verifiedProfiles } : {}),
};
---

{/* charset is emitted first in BaseLayout: it must fall inside the first
    1024 bytes of the document, and the blocking theme script precedes this. */}
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- theme-color lives in ThemeScript.astro: it must track the resolved theme,
     not prefers-color-scheme, or the browser chrome desyncs from the page. -->

<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name} — Writing`}
  href={absoluteUrl('/rss.xml', Astro.site)}
/>

<link rel="preload" as="font" type="font/woff2" href={inter} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={fraunces} crossorigin="anonymous" />

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
