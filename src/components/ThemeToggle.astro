---
/**
 * The only client-side JavaScript on the site.
 *
 * Three states, not two: once a visitor picks light or dark, a two-state
 * toggle gives them no way back to following their device. Cycles
 * system -> light -> dark -> system.
 *
 * The icon is chosen by [data-theme-mode] on <html>, which the blocking script
 * sets before first paint, so the button never shows the wrong icon first.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-muted transition-colors hover:bg-surface-hover hover:text-text"
  aria-label="Theme: follow device. Activate to switch to light."
>
  {/* system */}
  <svg
    class="icon icon-system h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="2.5" y="4" width="19" height="13" rx="2"></rect>
    <path d="M8.5 20.5h7M12 17.5v3"></path>
  </svg>

  {/* light */}
  <svg
    class="icon icon-light h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>

  {/* dark */}
  <svg
    class="icon icon-dark h-[18px] w-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style>
  .icon {
    display: none;
  }
  :global(:root[data-theme-mode='system']) .icon-system,
  :global(:root[data-theme-mode='light']) .icon-light,
  :global(:root[data-theme-mode='dark']) .icon-dark {
    display: block;
  }
  /* Before the blocking script runs (or with JS off) show the system icon. */
  :global(:root:not([data-theme-mode])) .icon-system {
    display: block;
  }
</style>

<script>
  type ThemeMode = 'system' | 'light' | 'dark';

  declare global {
    interface Window {
      __theme?: {
        apply: (mode: ThemeMode) => 'light' | 'dark';
        stored: () => 'light' | 'dark' | null;
        media: MediaQueryList;
      };
    }
  }

  const button = document.getElementById('theme-toggle');
  const ORDER: ThemeMode[] = ['system', 'light', 'dark'];

  const LABELS: Record<ThemeMode, string> = {
    system: 'Theme: follow device. Activate to switch to light.',
    light: 'Theme: light. Activate to switch to dark.',
    dark: 'Theme: dark. Activate to follow your device.',
  };

  function currentMode(): ThemeMode {
    const mode = document.documentElement.dataset.themeMode;
    return mode === 'light' || mode === 'dark' ? mode : 'system';
  }

  function setLabel(mode: ThemeMode) {
    button?.setAttribute('aria-label', LABELS[mode]);
  }

  setLabel(currentMode());

  button?.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(currentMode()) + 1) % ORDER.length]!;

    try {
      if (next === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: the choice just won't persist */
    }

    window.__theme?.apply(next);
    setLabel(next);
  });

  // The blocking script keeps the theme in sync with the device; this only
  // needs to refresh the label if the mode is still 'system'.
  window.__theme?.media.addEventListener('change', () => setLabel(currentMode()));
</script>
