---
interface Props {
  places: number;
  countries: number;
  workVisits: number;
}

const { places, countries, workVisits } = Astro.props as Props;

const stats = [
  { value: places, label: 'Visited places' },
  { value: countries, label: 'Countries' },
  { value: workVisits, label: 'Work visits' },
];
---

<dl class="grid grid-cols-3 divide-x divide-border border-y border-border py-5 text-center">
  {
    stats.map((stat) => (
      <div class="px-2 sm:px-6">
        <dd class="font-display text-2xl font-semibold tabular-nums sm:text-3xl">{stat.value}</dd>
        <dt class="mt-1 text-xs text-faint sm:text-sm">{stat.label}</dt>
      </div>
    ))
  }
</dl>
