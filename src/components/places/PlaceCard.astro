---
import { Image } from 'astro:assets';
import type { PlaceEntry } from '../../lib/places';
import {
  formatVisitMonth,
  isUpcomingPlace,
  latestVisit,
  placePurposes,
} from '../../lib/places';
import { url } from '../../lib/url';
import Tag from '../Tag.astro';

interface Props {
  place: PlaceEntry;
}

const { place } = Astro.props as Props;
const visit = latestVisit(place);
const purposes = placePurposes(place);
const upcoming = isUpcomingPlace(place);
const location = [place.data.locality, place.data.region, place.data.country]
  .filter((part, index, all) => part && all.indexOf(part) === index)
  .join(', ');
---

<article
  class="group relative overflow-hidden rounded-lg border border-border transition-colors hover:border-accent"
  data-place-id={place.id}
>
  <div class="grid sm:grid-cols-[13rem_1fr]">
    <Image
      src={place.data.cover}
      alt={place.data.coverAlt}
      width={520}
      height={360}
      class="aspect-[16/9] h-full w-full border-b border-border object-cover sm:aspect-auto sm:border-r sm:border-b-0"
      loading="lazy"
    />

    <div class="p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="text-xl">
            <a
              href={url(`/places/${place.id}`)}
              class="transition-colors group-hover:text-accent"
              data-place-link
            >
              <span class="absolute inset-0" aria-hidden="true"></span>
              {place.data.title}
            </a>
          </h3>
          <p class="mt-1 text-sm text-faint">{location}</p>
        </div>

        {upcoming && <Tag class="border-accent text-accent">Upcoming</Tag>}
      </div>

      <p class="mt-3 text-sm text-muted">{place.data.summary}</p>
      <p class="mt-4 text-xs text-faint">
        {visit.title} · <time datetime={visit.start}>{formatVisitMonth(visit)}</time>
      </p>

      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Purposes">
        {purposes.map((purpose) => <li><Tag>{purpose}</Tag></li>)}
        {place.data.placeholder && <li><Tag>sample content</Tag></li>}
      </ul>
    </div>
  </div>
</article>
