---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { formatDate, isoDate } from '../lib/date';
import { readingTime } from '../lib/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 2 on a listing page, 3 when nested under a section heading. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props as Props;
const Heading = `h${headingLevel}` as keyof astroHTML.JSX.DefinedIntrinsicElements;
---

<article class="group border-b border-border py-6 first:pt-0 last:border-b-0">
  <Heading class="text-lg">
    <a
      href={url(`/blog/${post.id}`)}
      class="transition-colors group-hover:text-accent"
    >
      {post.data.title}
      {post.data.draft && <span class="ml-2 align-middle text-xs text-accent">draft</span>}
    </a>
  </Heading>

  <p class="mt-2 text-muted">{post.data.description}</p>

  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
    <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(post.body)}</span>
  </p>
</article>
