---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import { formatDate, isoDate } from '../lib/date';
import { readingTime } from '../lib/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 2 on a listing page, 3 when nested under a section heading. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props as Props;
const Heading = `h${headingLevel}` as keyof astroHTML.JSX.DefinedIntrinsicElements;
const { title, description, pubDate, draft, heroImage, heroAlt } = post.data;
---

<article
  class="group relative flex flex-col gap-4 border-b border-border py-6 first:pt-0 last:border-b-0 sm:flex-row sm:gap-5"
>
  {
    heroImage && (
      <Image
        src={heroImage}
        alt={heroAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 640px) 12rem, 100vw"
        class="aspect-[16/9] w-full rounded-md border border-border object-cover sm:w-48 sm:shrink-0"
        loading="lazy"
      />
    )
  }

  <div class="min-w-0 flex-1">
    <Heading class="text-lg">
      <a
        href={url(`/blog/${post.id}`)}
        class="transition-colors group-hover:text-accent"
      >
        {/* Stretch the link over the whole row without nesting interactive elements */}
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
        {draft && <span class="ml-2 align-middle text-xs text-accent">draft</span>}
      </a>
    </Heading>

    <p class="mt-2 text-muted">{description}</p>

    <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)}</span>
    </p>
  </div>
</article>
