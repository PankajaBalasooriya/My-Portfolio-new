---
interface Props {
  title: string;
  /** Organisation, institution, or issuer. */
  subtitle?: string;
  meta?: string;
  /** Right-aligned date range on wide screens. */
  period?: string;
  bullets?: string[];
  description?: string;
}

const { title, subtitle, meta, period, bullets = [], description } = Astro.props as Props;
---

<li class="border-b border-border py-6 first:pt-0 last:border-b-0">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <div>
      <h3 class="font-medium">{title}</h3>
      {subtitle && <p class="text-muted">{subtitle}</p>}
    </div>
    {period && <p class="shrink-0 text-sm text-faint sm:text-right">{period}</p>}
  </div>

  {meta && <p class="mt-1 text-sm text-faint">{meta}</p>}
  {description && <p class="mt-3 text-muted">{description}</p>}

  {
    bullets.length > 0 && (
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-muted marker:text-faint">
        {bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }
</li>
