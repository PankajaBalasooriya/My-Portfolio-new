---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props as Props;

/** Only h2/h3 — deeper levels make the rail noisy. */
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav aria-labelledby="toc-heading" class="rounded-lg border border-border p-5 text-sm">
      <h2 id="toc-heading" class="font-display text-sm font-semibold">
        On this page
      </h2>
      <ol class="mt-3 space-y-1.5">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'ml-4' : undefined}>
            <a
              href={`#${heading.slug}`}
              class="text-muted transition-colors hover:text-accent"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
