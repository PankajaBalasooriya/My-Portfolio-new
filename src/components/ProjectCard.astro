---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** 2 on a listing page, 3 when nested under a section heading. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 2 } = Astro.props as Props;
const Heading = `h${headingLevel}` as keyof astroHTML.JSX.DefinedIntrinsicElements;
const { title, summary, role, period, tags, cover, coverAlt } = project.data;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-border transition-colors hover:border-accent"
>
  {
    cover && (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 640px) 22rem, 100vw"
        class="aspect-[16/9] w-full border-b border-border object-cover"
        loading="lazy"
      />
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <Heading class="text-lg">
      <a href={url(`/projects/${project.id}`)} class="transition-colors group-hover:text-accent">
        {/* Stretch the link over the whole card without nesting interactive elements */}
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </Heading>

    <p class="mt-1 text-sm text-faint">{role} · {period}</p>
    <p class="mt-3 flex-1 text-sm text-muted">{summary}</p>

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
