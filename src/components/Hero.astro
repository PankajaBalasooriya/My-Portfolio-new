---
import { getImage } from 'astro:assets';
import { site } from '../lib/site';
import { url } from '../lib/url';
import portraitTall from '../assets/portrait.png';
import portraitWide from '../assets/portrait-landscape.png';

/**
 * Art direction, not just resizing: the narrow viewport gets the landscape
 * crop full-width so the subject sits centred, while `sm` and up gets the 3:4
 * portrait beside the text. <picture> means only the matching source is
 * fetched — Astro's <Image> can only vary size, not the image itself.
 */
const wide = await getImage({
  src: portraitWide,
  // `width` fixes what the plain `src` fallback points at. Without it Astro
  // falls back to the full 2752px render (~220 KB) for any client that ignores
  // srcset; 828 is the widest a phone actually needs.
  width: 828,
  widths: [420, 640, 828, 1120],
  sizes: '100vw',
  format: 'webp',
});

const tall = await getImage({
  src: portraitTall,
  widths: [224, 288, 416, 576],
  sizes: '13rem',
  format: 'webp',
});

const alt = 'Pankaja Balasooriya, seated at a desk with a laptop.';
---

<section aria-labelledby="hero-heading">
  <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-12">
    {/* Text is first in the DOM so the h1 leads; CSS order puts the portrait
        on top at mobile widths and to the right from `sm` up. */}
    <div class="order-2 min-w-0 flex-1 sm:order-1">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-faint">
        {site.name}
      </p>

      <h1 id="hero-heading" class="hero-title mt-3">
        {site.hero.headline}
      </h1>

      <p class="mt-5 max-w-[50ch] text-lg leading-relaxed text-muted">
        {site.hero.sub}
      </p>

      <p class="mt-5 max-w-[52ch] text-sm text-faint">
        {site.role.study}<span class="mx-1.5" aria-hidden="true">·</span
        >{site.role.affiliation}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={url('/projects')}
          class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
        >
          View projects
        </a>
        <a
          href={url('/cv')}
          class="text-sm text-accent underline decoration-1 underline-offset-4 transition-colors hover:text-accent-hover"
        >
          Read the CV <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="order-1 w-full shrink-0 sm:order-2 sm:w-auto">
      <picture>
        <source
          media="(min-width: 640px)"
          srcset={tall.srcSet.attribute}
          sizes="13rem"
          width={tall.attributes.width}
          height={tall.attributes.height}
        />
        <img
          src={wide.src}
          srcset={wide.srcSet.attribute}
          sizes="100vw"
          width={wide.attributes.width}
          height={wide.attributes.height}
          alt={alt}
          class="aspect-[16/9] w-full rounded-lg border border-border object-cover sm:aspect-[3/4] sm:w-52"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>

  <hr class="mt-12 border-border" />
</section>

<style>
  /* Fluid rather than a hard jump at the `sm` breakpoint. Fraunces carries an
     optical-size axis, so let the browser use it at display sizes. */
  .hero-title {
    font-size: clamp(2rem, 1.25rem + 2.8vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    font-weight: 600;
    font-optical-sizing: auto;
    text-wrap: balance;
    max-width: 16ch;
  }
</style>
