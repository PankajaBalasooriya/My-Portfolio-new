---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../lib/site';
import { getFeaturedProjects } from '../lib/content';

const featured = await getFeaturedProjects();
---

<BaseLayout title={site.homeTitle} description={site.description}>
  <Container class="py-16 sm:py-24">
    <Hero />

    {
      featured.length > 0 && (
        <Section title="Featured projects" href="/projects" linkLabel="All projects" class="mt-20">
          <ul class="grid gap-6 sm:grid-cols-2">
            {featured.map((project) => (
              <li class="flex">
                <ProjectCard project={project} headingLevel={3} />
              </li>
            ))}
          </ul>
        </Section>
      )
    }
  </Container>
</BaseLayout>
