---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import Prose from '../components/Prose.astro';
import Timeline from '../components/Timeline.astro';
import type { TimelineItem } from '../components/Timeline.astro';
import { url } from '../lib/url';
import { CV_PDF, CV_PDF_DOWNLOAD_NAME, hasCvPdf } from '../lib/cv';
import { site, socials } from '../lib/site';
import { getExperience, getEducationByKind, getCertificates } from '../lib/content';

const experience = await getExperience();
const education = await getEducationByKind();
const certificates = await getCertificates();

const workEntries: TimelineItem[] = experience.map((entry) => ({
  org: entry.data.org,
  role: entry.data.role,
  location: entry.data.location,
  start: entry.data.start,
  end: entry.data.end,
  details: entry.data.bullets,
  logo: entry.data.logo,
  logoDark: entry.data.logoDark,
}));

const toEducationEntry = (entry: (typeof education.university)[number]): TimelineItem => ({
  org: entry.data.institution,
  role: entry.data.credential,
  location: entry.data.location,
  start: entry.data.start,
  end: entry.data.end,
  details: entry.data.details,
  logo: entry.data.logo,
  logoDark: entry.data.logoDark,
});

const profiles = socials.filter((s) => !s.href.startsWith('mailto:'));
---

<PageLayout
  title="About"
  description="Background, research, work experience, education, and how to get in touch."
  lede="I'm a final-year Electronic and Telecommunication Engineering undergraduate at the University of Moratuwa. I build intelligent systems end to end, from custom electronics and firmware to the control and learning layers that sit on top."
>
  <Prose>
    <p>
      Most of my work lives at the seam between hardware and intelligence. My final year project
      tackles distributed control for cooperative multi-drone payload transport using multi-agent
      reinforcement learning. I work on decentralized policy design and sim-to-real transfer.
      Before that I was a research intern at the Exertion Games Lab, Monash University, building
      sensing wearables and interactive systems for human-computer interaction research. That work
      led to publications at several ACM venues.
    </p>
    <p>
      I've designed circuit boards, written embedded firmware, built autonomous driving stacks, and
      placed in national robotics competitions. I like problems that don't let me stay in one layer
      of the stack.
    </p>
    <p>
      When I'm not building, I'm usually flying a drone somewhere or chasing light for a photograph.
    </p>
  </Prose>

  <Section title="Work experience" class="mt-16">
    <Timeline entries={workEntries} headingLevel={3} />
  </Section>

  <Section title="Education" class="mt-16">
    <h3 class="mb-5 font-display text-sm font-semibold uppercase tracking-widest text-faint">
      Higher education
    </h3>
    <Timeline entries={education.university.map(toEducationEntry)} headingLevel={4} />

    {
      education.school.length > 0 && (
        <>
          <h3 class="mb-5 mt-12 font-display text-sm font-semibold uppercase tracking-widest text-faint">
            School
          </h3>
          <Timeline entries={education.school.map(toEducationEntry)} headingLevel={4} />
        </>
      )
    }

    {
      certificates.length > 0 && (
        <>
          <h3 class="mb-5 mt-12 font-display text-sm font-semibold uppercase tracking-widest text-faint">
            Certificates and courses
          </h3>
          {/* Single-date items, so a list rather than a timeline. */}
          <ul class="space-y-4">
            {certificates.map((entry) => (
              <li class="border-b border-border pb-4 last:border-b-0 last:pb-0">
                <div class="sm:flex sm:items-baseline sm:justify-between sm:gap-6">
                  <h4 class="font-medium">{entry.data.title}</h4>
                  <p class="mt-0.5 shrink-0 text-sm tabular-nums text-faint sm:mt-0">
                    {entry.data.date}
                  </p>
                </div>
                <p class="mt-0.5 text-sm text-muted">{entry.data.issuer}</p>
                {entry.data.details.length > 0 && (
                  <p class="mt-1 text-sm text-faint">{entry.data.details.join(' · ')}</p>
                )}
              </li>
            ))}
          </ul>
        </>
      )
    }

    <p class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <a
        href={url('/cv')}
        class="text-accent underline decoration-1 underline-offset-4 transition-colors hover:text-accent-hover"
      >
        Everything on one page, print-ready <span aria-hidden="true">→</span>
      </a>
      {
        hasCvPdf && (
          <a
            href={url(`/${CV_PDF}`)}
            download={CV_PDF_DOWNLOAD_NAME}
            class="text-muted underline decoration-1 underline-offset-4 transition-colors hover:text-accent"
          >
            Download CV (PDF)
          </a>
        )
      }
    </p>
  </Section>

  <Section title="Get in touch" class="mt-16">
    <p class="max-w-[60ch] text-muted">
      Email is the best way to reach me. I am also on the networks below.
    </p>

    <p class="mt-6">
      <a
        href={`mailto:${site.author.email}`}
        class="inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
      >
        {site.author.email}
      </a>
    </p>

    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        profiles.map((profile) => (
          <li>
            <a
              href={profile.href}
              rel="me noopener"
              class="text-muted underline decoration-1 underline-offset-4 transition-colors hover:text-accent"
            >
              {profile.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</PageLayout>
