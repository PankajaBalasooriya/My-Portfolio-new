---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Tag from '../../components/Tag.astro';
import { url } from '../../lib/url';
import { getPosts, getPostTags } from '../../lib/content';

const LINK =
  'text-accent underline decoration-1 underline-offset-4 transition-colors hover:text-accent-hover';

const posts = await getPosts();
const tags = await getPostTags();
---

<PageLayout
  title="Blog"
  description="Notes on electronics, embedded systems, machine learning, and research."
  lede="Occasional notes on things I have built, broken, or read."
>
  {
    tags.length > 0 && (
      <nav aria-label="Post tags" class="mb-10">
        <ul class="flex flex-wrap gap-2">
          {tags.map(({ tag, count }) => (
            <li>
              <Tag href={`/blog/tags/${tag}`}>
                {tag} <span class="text-faint">{count}</span>
              </Tag>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    posts.length > 0 ? (
      <div>
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="max-w-[60ch] text-muted">
        Nothing written up here yet. The posts are still to come; in the
        meantime, <a href={url('/projects')} class={LINK}>projects</a> and{' '}
        <a href={url('/research')} class={LINK}>research</a> carry the actual
        work.
      </p>
    )
  }
</PageLayout>
